# Copie para ".env" e preencha. NUNCA commite o .env.

# Banco de dados (MySQL)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=petshop

# Usuário administrador criado no primeiro uso (senha vira hash bcrypt)
ADMIN_EMAIL=admin@petshop.com
ADMIN_SENHA=

# Localização do pet shop (usada para calcular a distância até o cliente).
# Informe o CEP da loja OU a latitude/longitude exatas (as coordenadas têm prioridade).
LOJA_CEP=
LOJA_LATITUDE=
LOJA_LONGITUDE=

# Taxa de entrega (distancia via API de rotas OSRM + Nominatim)
ENTREGA_TAXA_BASE=6.00
ENTREGA_TAXA_POR_KM=1.80
ENTREGA_FRETE_GRATIS_ACIMA=0
ENTREGA_TEMPO_PREPARO_MIN=35
ENTREGA_VELOCIDADE_KMH=22

# Cotação do dólar (RF12): a API usada é pública e não exige chave.
# Opcional: sobrescreva a URL padrão da AwesomeAPI, se desejar.
# COTACAO_DOLAR_URL=https://economia.awesomeapi.com.br/json/last/USD-BRL

# E-mail de confirmação de pedido (RF11).
# Sem SMTP_HOST o envio é simulado: o HTML do e-mail é salvo na pasta ./emails; o pedido é criado normalmente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SEGURANCA=false
EMAIL_REMETENTE=nao-responda@petshop.local
EMAIL_REMETENTE_NOME=Pet Shop Delivery
